{
  "name": "aanjnadham-backend",
  "version": "1.0.0",
  "description": "Anjanadham backend API with Node.js, Express, and MySQL",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon --watch src --watch .env --watch .env.local --ext js,json,env,local src/server.js",
    "db:migrate": "node src/database/migrate.js",
    "announcements:enable": "node scripts/enableAnnouncements.js",
    "content:import-frontend": "node scripts/importFrontendContent.js",
    "uploads:migrate-legacy": "node scripts/migrateLegacyUploads.js",
    "media:migrate": "node scripts/adminMedia.js migrate",
    "media:cleanup": "node scripts/adminMedia.js cleanup",
    "media:catalog": "node scripts/adminMedia.js catalog"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "mysql2": "^3.11.5",
    "nodemailer": "^6.10.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
